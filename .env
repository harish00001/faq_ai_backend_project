APP_NAME=FAQ AI Backend
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./faq_ai.db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INDEX_DIR=./storage/index
INDEX_FILE=./storage/index/faiss.index
METADATA_FILE=./storage/index/metadata.json
TOP_K_DEFAULT=3
SIMILARITY_THRESHOLD=0.75
